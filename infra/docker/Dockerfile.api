FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/inspector-miniapp/package.json apps/inspector-miniapp/
COPY packages/contracts/package.json packages/contracts/
COPY packages/templates/package.json packages/templates/
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run prisma:generate && npm run build -w @jianjian/contracts && npm run build -w @jianjian/templates && npm run build -w @jianjian/api

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/inspector-miniapp/package.json apps/inspector-miniapp/
COPY packages/contracts/package.json packages/contracts/
COPY packages/templates/package.json packages/templates/
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/packages/contracts/dist packages/contracts/dist
COPY --from=build /app/packages/templates/dist packages/templates/dist
EXPOSE 3000
USER node
CMD ["node", "apps/api/dist/main.js"]
